<!--  Outer ConstraintLayout ensures the empty message is centered to Overview. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--  Inner ConstraintLayout ensures height/width of background scales uniformly.  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@drawable/overview_empty_recents_12_sided_cookie_background"
        android:focusable="true"
        android:maxHeight="@dimen/recents_empty_message_background_size_large"
        android:maxWidth="@dimen/recents_empty_message_background_size_large"
        android:minHeight="@dimen/recents_empty_message_background_size"
        android:minWidth="@dimen/recents_empty_message_background_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1">

        <TextView
            android:id="@+id/empty_recents_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/recents_empty_message_text_padding"
            android:drawableTop="@drawable/overview_empty_recents_icon"
            android:focusable="false"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingHorizontal="@dimen/recents_empty_message_text_padding"
            android:text="@string/recents_empty_message"
            android:textColor="@color/materialColorOnSurface"
            android:textSize="@dimen/recents_empty_message_text_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
