<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.folder.largefolder.LargeFolderIcon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.android.launcher3.CellLayout
        android:id="@+id/large_folder_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.android.launcher3.views.DoubleShadowBubbleTextView
        android:id="@+id/large_folder_name"
        style="@style/BaseIcon.Workspace"
        android:layout_width="match_parent"
        android:layout_height="0.0dip"
        android:layout_gravity="top"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="?attr/workspaceTextColor"
        app:iconDisplay="collection_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/large_folder_content" />
</com.android.launcher3.folder.largefolder.LargeFolderIcon>