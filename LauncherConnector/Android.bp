package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_static {
    name: "LauncherConnectorProtoLib",
    srcs: [
        "src/com/android/launcherconnector/**/*.proto",
    ],
    proto: {
        type: "lite",
        local_include_dirs: [
            "src/com/android/launcherconnector",
        ],
    },
}

android_app {
    name: "LauncherConnector",
    certificate: "platform",
    // TODO: b/463653293 - Confirm whether the app should be privileged.
    privileged: false,
    optimize: {
        enabled: true,
    },
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],
    static_libs: [
        "androidx.appcompat_appcompat",
        "LauncherConnectorProtoLib",
        "grpc-java-api",
        "grpc-java-binder",
        "libprotobuf-java-lite",
        "grpc-java-lite",
    ],
    resource_dirs: ["res"],
    platform_apis: true,
}
